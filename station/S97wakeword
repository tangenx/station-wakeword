#!/bin/sh
# wakeword: start the custom wake-word daemon at boot.
#
# Works from either layout:
#   /data/wakeword                      (install.sh: binary + negatives together)
#   /data/yam/share/tangenx.wakeword    (yam package: binary in /data/yam/bin
#   or the package payload dir, negatives here)
# The daemon changes nothing in the firmware; it reconnects to maind until the
# platform is up. This script lives on the read-only rootfs and disappears with
# an OTA update.
DIR=/data/wakeword
YAM_SHARE=/data/yam/share/tangenx.wakeword
PIDFILE=/tmp/wakeword.pid
LOG=/tmp/wakeword.log

# find_payload — locate the binary and negatives.bin.
find_binary() {
    for p in "$DIR/wakeword" /data/yam/bin/wakeword \
        /data/yam/pkgs/tangenx/wakeword/*/files/bin/wakeword; do
        [ -x "$p" ] && { echo "$p"; return; }
    done
}

find_negatives() {
    for p in /data/wakeword/negatives.bin "$YAM_SHARE/negatives.bin" \
        /data/yam/pkgs/tangenx/wakeword/*/files/share/tangenx.wakeword/negatives.bin; do
        [ -f "$p" ] && { echo "$p"; return; }
    done
}

case "$1" in
    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "wakeword: already running"
            exit 0
        fi
        BIN=$(find_binary)
        NEGATIVES=$(find_negatives)
        if [ -z "$BIN" ]; then
            echo "wakeword: no binary found in $DIR or /data/yam"
            exit 1
        fi
        # Low priority: Alice's own audio pipeline must never starve.
        if [ -n "$NEGATIVES" ]; then
            ARGS="run -data '$DIR' -negatives '$NEGATIVES'"
        else
            ARGS="run -data '$DIR'"
        fi
        start-stop-daemon -S -b -m -p "$PIDFILE" -N 10 -x /bin/sh -- \
            -c "eval exec '$BIN' $ARGS >> '$LOG' 2>&1"
        echo "wakeword: started ($BIN)"
        ;;
    stop)
        [ -f "$PIDFILE" ] && start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
        rm -f "$PIDFILE"
        echo "wakeword: stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
