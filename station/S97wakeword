#!/bin/sh
# wakeword: custom wake words. Starts the detector daemon at boot.
#
# The daemon only reads the mic stream and asks Alice to listen over maind's
# local IPC; it changes nothing in the firmware, so it may start before or
# after S99quasar (it reconnects until maind is up). This script lives on the
# read-only rootfs and disappears with an OTA update.
DIR=/data/wakeword
BIN="$DIR/wakeword"
PIDFILE=/tmp/wakeword.pid
LOG=/tmp/wakeword.log

case "$1" in
    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "wakeword: already running"
            exit 0
        fi
        [ -x "$BIN" ] || { echo "wakeword: no binary at $BIN"; exit 1; }
        # Low priority: Alice's own audio pipeline must never starve.
        start-stop-daemon -S -b -m -p "$PIDFILE" -N 10 -x /bin/sh -- \
            -c "exec '$BIN' run -data '$DIR' >> '$LOG' 2>&1"
        echo "wakeword: started"
        ;;
    stop)
        [ -f "$PIDFILE" ] && start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
        rm -f "$PIDFILE"
        echo "wakeword: stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
